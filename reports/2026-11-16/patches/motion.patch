--- /dev/null
+++ b/motion/tests/test_run_all.py
@@ -0,0 +1,127 @@
+"""run_all.py 의 단계 건너뛰기·다시 만들기·종료 코드를 검사한다.
+
+실제 영상 분석 대신 가짜 단계 스크립트를 쓰므로 mediapipe 없이 몇 초 만에 돈다.
+    python3 -m unittest discover -s motion/tests
+"""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+RUN_ALL = os.environ.get("RUN_ALL") or os.path.join(HERE, "..", "run_all.py")
+
+STUB = r'''
+import json, os, sys
+name = os.path.basename(__file__)
+args = sys.argv[1:]
+out = args[args.index("--out-dir") + 1]
+std = args[args.index("--standard") + 1] if "--standard" in args else None
+stem = os.path.splitext(os.path.basename(args[0]))[0] if std is None else os.path.basename(std)[:-len("_standard.json")]
+with open(os.path.join(out, "calls.log"), "a", encoding="utf-8") as fh:
+    fh.write(name + " " + " ".join(args) + "\n")
+fail = os.environ.get("STUB_FAIL", "")
+if fail and fail in name:
+    sys.exit(1)
+target = {"preflight.py": "preflight", "build_standard.py": "standard", "capture_shots.py": "shots",
+          "find_risks.py": "risks", "build_ji.py": "ji"}[name]
+data = {"verdict": os.environ.get("STUB_VERDICT", "진행 가능"), "recommend": {}} if target == "preflight" else {"by": args}
+with open(os.path.join(out, stem + "_" + target + ".json"), "w", encoding="utf-8") as fh:
+    json.dump(data, fh)
+'''
+
+
+class RunAll(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.mkdtemp()
+        self.bin = os.path.join(self.dir, "bin")
+        os.makedirs(self.bin)
+        shutil.copy(RUN_ALL, os.path.join(self.bin, "run_all.py"))
+        for s in ("preflight.py", "build_standard.py", "capture_shots.py", "find_risks.py", "build_ji.py"):
+            with open(os.path.join(self.bin, s), "w", encoding="utf-8") as fh:
+                fh.write(STUB)
+        self.video = os.path.join(self.dir, "work.mp4")
+        with open(self.video, "wb") as fh:
+            fh.write(b"video")
+        self.zones = os.path.join(self.dir, "zones.json")
+        with open(self.zones, "w", encoding="utf-8") as fh:
+            fh.write("{}")
+        self.out = os.path.join(self.dir, "out")
+
+    def tearDown(self):
+        shutil.rmtree(self.dir, ignore_errors=True)
+
+    def run_all(self, *extra, env=None):
+        log = os.path.join(self.out, "calls.log")
+        if os.path.exists(log):
+            os.remove(log)
+        p = subprocess.run([sys.executable, os.path.join(self.bin, "run_all.py"), self.video,
+                            "--out-dir", self.out, "--no-next", *extra],
+                           capture_output=True, text=True, env={**os.environ, **(env or {})})
+        calls = []
+        if os.path.exists(log):
+            with open(log, encoding="utf-8") as fh:
+                calls = fh.read().split()
+        ran = [c for c in calls if c.endswith(".py")]
+        return p, ran
+
+    def test_second_run_with_zones_rebuilds_from_standard(self):
+        p, ran = self.run_all()
+        self.assertEqual(p.returncode, 0, p.stdout + p.stderr)
+        self.assertEqual(len(ran), 5)
+        p, ran = self.run_all("--zones", self.zones)
+        self.assertEqual(p.returncode, 0)
+        self.assertEqual(ran, ["build_standard.py", "capture_shots.py", "find_risks.py", "build_ji.py"])
+
+    def test_unchanged_inputs_skip_to_document(self):
+        self.run_all("--zones", self.zones)
+        p, ran = self.run_all("--zones", self.zones)
+        self.assertEqual(ran, ["build_ji.py"])
+
+    def test_edited_zones_file_triggers_rebuild(self):
+        self.run_all("--zones", self.zones)
+        time.sleep(0.01)
+        with open(self.zones, "w", encoding="utf-8") as fh:
+            fh.write('{"changed": 1}')
+        p, ran = self.run_all("--zones", self.zones)
+        self.assertIn("build_standard.py", ran)
+
+    def test_reshoot_verdict_exits_2(self):
+        p, ran = self.run_all(env={"STUB_VERDICT": "재촬영 권장"})
+        self.assertEqual(p.returncode, 2)
+        self.assertEqual(ran, ["preflight.py"])
+        p, ran = self.run_all("--from", "standard", env={"STUB_VERDICT": "재촬영 권장"})
+        self.assertEqual(p.returncode, 0)
+
+    def test_failed_shots_not_used_and_exit_3(self):
+        self.run_all()
+        p, ran = self.run_all("--zones", self.zones, env={"STUB_FAIL": "capture_shots"})
+        self.assertEqual(p.returncode, 3)
+        with open(os.path.join(self.out, "calls.log"), encoding="utf-8") as fh:
+            ji = fh.read().splitlines()[-1]
+        self.assertTrue(ji.startswith("build_ji.py"))
+        self.assertNotIn("--shots", ji)          # 옛 사진을 새 표준에 붙이지 않음
+        p, ran = self.run_all("--zones", self.zones)
+        self.assertIn("capture_shots.py", ran)    # 지난번 실패는 다시 시도
+
+    def test_document_failure_exits_1(self):
+        p, _ = self.run_all(env={"STUB_FAIL": "build_ji"})
+        self.assertEqual(p.returncode, 1)
+
+    def test_legacy_outputs_without_record_are_rebuilt_once(self):
+        os.makedirs(self.out)
+        for t in ("preflight", "standard", "shots", "risks"):
+            with open(os.path.join(self.out, f"work_{t}.json"), "w", encoding="utf-8") as fh:
+                json.dump({"verdict": "진행 가능"} if t == "preflight" else {}, fh)
+        p, ran = self.run_all()
+        self.assertEqual(len(ran), 5)
+        p, ran = self.run_all()
+        self.assertEqual(ran, ["build_ji.py"])
+
+
+if __name__ == "__main__":
+    unittest.main()
