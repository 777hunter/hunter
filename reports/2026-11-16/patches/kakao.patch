diff --git a/tests/test_kakao_tokens.py b/tests/test_kakao_tokens.py
new file mode 100644
index 0000000..15df4aa
--- /dev/null
+++ b/tests/test_kakao_tokens.py
@@ -0,0 +1,63 @@
+"""카카오 토큰 상태 전이 검사 (네트워크 없이 requests.post 를 바꿔 끼운다).
+
+    python3 -m unittest discover -s tests
+"""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from news_card import config, kakao
+
+
+class Resp:
+    def __init__(self, status, payload):
+        self.status_code, self._p, self.text = status, payload, json.dumps(payload)
+
+    def json(self):
+        return self._p
+
+
+class Tokens(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.mkdtemp()
+        patches = [mock.patch.object(config, "TOKEN_FILE", Path(self.dir) / "kakao_token.json"),
+                   mock.patch.object(config, "KAKAO_REST_API_KEY", "key"),
+                   mock.patch.object(config, "KAKAO_ACCESS_TOKEN", ""),
+                   mock.patch.object(config, "KAKAO_REFRESH_TOKEN", "r-old")]
+        for p in patches:
+            p.start()
+            self.addCleanup(p.stop)
+        self.calls = []
+
+    def post(self, script):
+        def fake(url, headers=None, data=None, timeout=None):
+            self.calls.append((url, dict(data or {}), headers))
+            return script.pop(0)
+        return mock.patch.object(kakao.requests, "post", side_effect=fake)
+
+    def test_refresh_only_config_refreshes_first(self):
+        with self.post([Resp(200, {"access_token": "a1"}), Resp(200, {"result_code": 0})]):
+            kakao.send_to_me({"object_type": "text"})
+        self.assertEqual(self.calls[0][0], kakao.TOKEN_REFRESH_URL)
+        self.assertEqual(self.calls[1][2]["Authorization"], "Bearer a1")
+
+    def test_rotated_refresh_token_is_kept_and_used_next_time(self):
+        with self.post([Resp(200, {"access_token": "a1", "refresh_token": "r-new"}), Resp(200, {})]):
+            kakao.send_to_me({})
+        saved = json.loads(config.TOKEN_FILE.read_text(encoding="utf-8"))
+        self.assertEqual(saved, {"access_token": "a1", "refresh_token": "r-new"})
+        with self.post([Resp(401, {}), Resp(200, {"access_token": "a2"}), Resp(200, {})]):
+            kakao.send_to_me({})
+        self.assertEqual(self.calls[-2][1]["refresh_token"], "r-new")
+        self.assertEqual(json.loads(config.TOKEN_FILE.read_text(encoding="utf-8"))["refresh_token"], "r-new")
+
+    def test_refresh_failure_raises(self):
+        with self.post([Resp(400, {"error": "invalid_grant"})]):
+            with self.assertRaises(kakao.KakaoError):
+                kakao.send_to_me({})
+
+
+if __name__ == "__main__":
+    unittest.main()
