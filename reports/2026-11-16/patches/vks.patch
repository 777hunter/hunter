+"""vks.py 색인 갱신과 vks_timeline.py 기준선을 외부 API 없이 검사한다.
+
+    python3 -m unittest discover -s tests
+"""
+import argparse
+import json
+import os
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+sys.modules.setdefault("anthropic", types.SimpleNamespace(Anthropic=object))
+import vks            # noqa: E402
+import vks_timeline   # noqa: E402
+
+
+class Index(unittest.TestCase):
+    def setUp(self):
+        self.dir = Path(tempfile.mkdtemp())
+        (self.dir / "a.md").write_text("A 새 내용", encoding="utf-8")
+        (self.dir / "b.md").write_text("B 내용", encoding="utf-8")
+        self.index = self.dir / "index.json"
+        old = {"documents": [{"file": str(self.dir / "a.md"), "title": "A 옛 요약", "hash": "old"}]}
+        self.index.write_text(json.dumps(old), encoding="utf-8")
+        for name, val in (("INDEX_FILE", self.index),):
+            p = mock.patch.object(vks, name, val); p.start(); self.addCleanup(p.stop)
+        p = mock.patch.object(vks, "collect_documents", return_value=[self.dir / "a.md", self.dir / "b.md"])
+        p.start(); self.addCleanup(p.stop)
+        p = mock.patch.object(vks, "make_client", return_value=None); p.start(); self.addCleanup(p.stop)
+
+    def test_failed_changed_doc_keeps_old_entry_and_exits_1(self):
+        def summ(client, model, rel, text):
+            if rel.endswith("a.md"):
+                raise RuntimeError("API 오류")
+            return {"title": "B", "summary": "", "category": "", "keywords": []}
+        with mock.patch.object(vks, "summarize_document", side_effect=summ):
+            with self.assertRaises(SystemExit) as cm:
+                vks.cmd_index("m")
+        self.assertEqual(cm.exception.code, 1)
+        titles = [d["title"] for d in json.loads(self.index.read_text(encoding="utf-8"))["documents"]]
+        self.assertIn("A 옛 요약", titles)
+        self.assertIn("B", titles)
+
+    def test_interrupt_keeps_finished_summaries(self):
+        def summ(client, model, rel, text):
+            if rel.endswith("b.md"):
+                raise KeyboardInterrupt
+            return {"title": "A 새 요약", "summary": "", "category": "", "keywords": []}
+        with mock.patch.object(vks, "summarize_document", side_effect=summ):
+            with self.assertRaises(KeyboardInterrupt):
+                vks.cmd_index("m")
+        titles = [d["title"] for d in json.loads(self.index.read_text(encoding="utf-8"))["documents"]]
+        self.assertEqual(titles, ["A 새 요약"])
+
+
+class Timeline(unittest.TestCase):
+    def versions(self):
+        return [{"number": 1, "when": "2026-06-01T09:00:00.000+09:00", "by": "x", "message": "", "minor": False},
+                {"number": 2, "when": "2026-06-10T09:00:00.000+09:00", "by": "x", "message": "", "minor": False},
+                {"number": 3, "when": "2026-06-10T15:00:00.000+09:00", "by": "x", "message": "", "minor": False}]
+
+    def run_timeline(self, date_from, save):
+        texts = {1: "처음", 2: "중간", 3: "최종"}
+        cf = mock.Mock()
+        cf.page_info.return_value = {"title": "T", "space": "S", "current_version": 3}
+        cf.list_versions.return_value = self.versions()
+        cf.version_body_text.side_effect = lambda pid, n, cur: texts[n]
+        cf.base = "https://vks"
+        diffs = []
+        with mock.patch.object(vks_timeline, "Confluence", return_value=cf), \
+             mock.patch.object(vks_timeline, "resolve_page_id", return_value="1"), \
+             mock.patch.object(vks_timeline, "make_anthropic", return_value=None), \
+             mock.patch.object(vks_timeline, "summarize_baseline", return_value="기준 요약"), \
+             mock.patch.object(vks_timeline, "summarize_change",
+                               side_effect=lambda c, t, l, e, d: diffs.append(d) or "변경 요약"):
+            vks_timeline.run(argparse.Namespace(page="1", date_from=date_from, date_to="2026-06-10",
+                                                bucket="day", list_versions=False, save=save))
+        return diffs
+
+    def test_single_day_range_shows_change_from_previous_version(self):
+        save = os.path.join(tempfile.mkdtemp(), "r.md")
+        diffs = self.run_timeline("2026-06-10", save)
+        self.assertEqual(len(diffs), 1)
+        self.assertIn("-처음", diffs[0])
+        self.assertIn("+최종", diffs[0])
+        self.assertIn("기간 시작 직전", Path(save).read_text(encoding="utf-8"))
+
+
+if __name__ == "__main__":
+    unittest.main()
