# ────────────────────────────────────────────────────────────
#  카카오톡 자동 송출 설정 (.env 로 복사한 뒤 값을 채우세요)
#  cp .env.example .env
# ────────────────────────────────────────────────────────────

# [필수] 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# [필수] 액세스 토큰 (talk_message 권한 필요)
#   - 임시로 발급받은 액세스 토큰을 넣어도 되지만 몇 시간 뒤 만료됩니다.
#   - 아래 REFRESH TOKEN 을 설정하면 만료 시 자동으로 재발급합니다.
KAKAO_ACCESS_TOKEN=

# [권장] 리프레시 토큰 (설정 시 액세스 토큰 만료를 자동 갱신 → 진짜 "자동 송출"이 됩니다)
KAKAO_REFRESH_TOKEN=

# [선택] 뉴스를 실시간으로 가져올 RSS 주소 (비워두면 data/ 의 로컬 JSON 사용)
#   예: 연합뉴스 최신뉴스 RSS → https://www.yonhapnewstv.co.kr/browse/feed/
NEWS_RSS_URL=

# [선택] 카드에 넣을 뉴스 개수
NEWS_LIMIT=5

# [선택] 카카오 피드 카드에 넣을 대표 이미지 URL (공개 URL 이어야 함)
CARD_IMAGE_URL=
